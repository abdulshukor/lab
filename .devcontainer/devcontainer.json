{
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker-host.sock,type=bind"
  ],

  "postCreateCommand": "bash ./scripts/setup",

  "forwardPorts": [
    10115,
    10116,
    10117
  ]
}
